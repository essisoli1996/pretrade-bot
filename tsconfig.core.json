{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ES2022",
  "moduleResolution": "bundler",
  "lib": [
   "ES2022"
  ],
  "strict": true,
  "noEmit": true,
  "skipLibCheck": true,
  "allowJs": true,
  "checkJs": false,
  "noImplicitAny": false,
  "types": [
   "node"
  ]
 },
 "include": [
  "bot/core/**/*"
 ]
}
