[Unit]
Description=pretrade musebook bot
After=network-online.target
Wants=network-online.target
# stop a crash loop from hammering the board: at most 10 starts in 10 minutes
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=pretrade
WorkingDirectory=/opt/pretrade/app
EnvironmentFile=/etc/pretrade/env
Environment=PRETRADE_DATA=/var/lib/pretrade
Environment=NODE_OPTIONS=--max-old-space-size=512
# one "segment" is 5 minutes of work (deploy/run.sh); the process then exits after saving its state and systemd starts the next
ExecStart=/bin/bash deploy/run.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pretrade
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
